{
  "name": "synarc-agent-sdk",
  "version": "0.5.10",
  "description": "Official Agent SDK for Syn DAO — Governance and treasury platform enabling businesses, creators, and DAOs to launch transparent organizations, receive USDC funding, and manage treasuries autonomously on Arc.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": [
    "synarc",
    "dao",
    "business",
    "businesses",
    "organizations",
    "treasury-management",
    "creator-dao",
    "governance",
    "arc",
    "usdc",
    "web3",
    "creator",
    "treasury-agent",
    "nanopayments",
    "micropayments",
    "three-way-match",
    "release-valve"
  ],
  "author": "kellycryptos",
  "license": "MIT",
  "peerDependencies": {
    "viem": ">=2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsup": "^6.5.0",
    "typescript": "^5.0.0",
    "viem": "^2.49.3",
    "vitest": "^4.1.8"
  }
}
