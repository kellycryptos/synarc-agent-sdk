{
  "name": "synarc-agent-sdk",
  "version": "0.4.0",
  "description": "SDK for integrating SynArc Creator Economy, nanopayments, governance, and treasury on Arc Network",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",

  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": [
    "synarc",
    "dao",
    "governance",
    "arc",
    "usdc",
    "web3",
    "creator",
    "nanopayments",
    "micropayments",
    "lepton",
    "fan-support"
  ],
  "author": "kellycryptos",
  "license": "MIT",
  "peerDependencies": {
    "viem": "^0.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsup": "^6.5.0",
    "typescript": "^5.0.0",
    "viem": "^0.2.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
